# Основной registry
registry=https://registry.npmjs.org/

# Отключить аутентификацию по умолчанию
always-auth=false

# Увеличить таймауты для медленных соединений
fetch-retries=3
fetch-retry-mintimeout=60000
fetch-retry-maxtimeout=300000

# Кеширование зависимостей
cache-lock-stale=60000
cache-lock-retries=10
cache-lock-wait=10000

# Для работы с пакетами Expo
@expo:registry=https://registry.npmjs.org/
@expo-cli:registry=https://registry.npmjs.org/
@eas:registry=https://registry.npmjs.org/